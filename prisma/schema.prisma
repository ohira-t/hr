generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Assignee {
  id       String  @id
  name     String  @unique
  isActive Boolean @default(true)
  order    Int     @default(0)
}

model MediaManagement {
  id        String    @id
  projectId String
  mediaName String
  status    String    @default("未掲載")
  startDate DateTime?
  endDate   DateTime?
  updatedAt DateTime
  Project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaName])
}

model Project {
  id                 String            @id
  hrId               String            @unique
  segment            String
  category           String
  clientName         String
  clientNameKana     String            @default("")
  clientId           String            @default("")
  applicationId      String            @default("")
  prefecture         String            @default("")
  city               String            @default("")
  facilityName       String            @default("")
  position           String            @default("サビ管")
  employmentType     String            @default("正社員")
  targetHiringCount  Int               @default(1)
  currentHiringCount Int               @default(0)
  status             String            @default("採用活動中")
  assignee           String            @default("")
  department         String            @default("推進部")
  targetPeriod       String?                               // ターゲット期（例: "17期下半期"）
  handoverDate       DateTime?
  deadlineDate       DateTime?
  openingDate        String?
  hurdles            String            @default("")
  notes              String            @default("")
  nextAction         String            @default("")
  createdAt          DateTime          @default(now())
  lastUpdated        DateTime
  MediaManagement    MediaManagement[]
}
